.PHONY: help install run dev prod docker-build docker-up docker-down docker-logs clean test format lint

help:
	@echo "VidZilla Bot - Mavjud buyruqlar:"
	@echo ""
	@echo "  make install      - Kutubxonalarni o'rnatish"
	@echo "  make run          - Botni ishga tushirish"
	@echo "  make dev          - Development rejimida ishga tushirish (polling)"
	@echo "  make prod         - Production rejimida ishga tushirish (webhook)"
	@echo ""
	@echo "  make docker-build - Docker image yaratish"
	@echo "  make docker-up    - Docker containerlarni ishga tushirish"
	@echo "  make docker-down  - Docker containerlarni to'xtatish"
	@echo "  make docker-logs  - Docker loglarini ko'rish"
	@echo ""
	@echo "  make test         - Testlarni ishga tushirish"
	@echo "  make format       - Kodni formatlash"
	@echo "  make lint         - Kodni tekshirish"
	@echo "  make clean        - Tozalash"

install:
	pip install -r requirements.txt

run:
	python main.py

dev:
	@echo "Development rejimida ishga tushirilmoqda..."
	@echo "USE_WEBHOOK=false" > .env.local
	python main.py

prod:
	@echo "Production rejimida ishga tushirilmoqda..."
	python main.py

docker-build:
	docker-compose build

docker-up:
	docker-compose up -d
	@echo "✅ Bot ishga tushdi"
	@echo "Loglar: make docker-logs"

docker-down:
	docker-compose down

docker-logs:
	docker-compose logs -f

docker-restart:
	docker-compose restart

clean:
	find . -type d -name "__pycache__" -exec rm -rf {} +
	find . -type f -name "*.pyc" -delete
	find . -type f -name "*.pyo" -delete
	find . -type f -name "*.log" -delete
	rm -rf .pytest_cache
	rm -rf .coverage
	rm -rf htmlcov
	rm -rf dist
	rm -rf build
	rm -rf *.egg-info

test:
	pytest -v

format:
	black .

lint:
	flake8 .

setup:
	@if [ ! -f .env ]; then \
		echo "📝 .env fayl yaratilmoqda..."; \
		cp .env.example .env; \
		echo "✅ .env yaratildi. Iltimos sozlang!"; \
	else \
		echo "⚠️  .env allaqachon mavjud"; \
	fi
	@mkdir -p downloads temp logs
	@echo "✅ Papkalar yaratildi"

check-env:
	@if [ ! -f .env ]; then \
		echo "❌ .env fayl topilmadi!"; \
		echo "   'make setup' buyrug'ini bajaring"; \
		exit 1; \
	fi
	@echo "✅ .env fayl mavjud"